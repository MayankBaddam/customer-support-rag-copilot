# Backend runtime configuration. Keep secrets out of source control.
ENVIRONMENT=development
# Pooled Supabase connection for application runtime (usually port 6543).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:6543/postgres
# Direct Supabase connection for Alembic migrations (usually port 5432).
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SECRET_KEY=replace_me
SUPABASE_STORAGE_BUCKET=knowledge-documents
MAX_DOCUMENT_SIZE_BYTES=5242880
SEED_DEMO_USER_ID=replace_with_supabase_auth_user_uuid
CORS_ORIGINS=http://localhost:3000,https://frontend.example.com

# Frontend-safe configuration only.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# Backend-only AI configuration; do not add these to frontend variables.
GEMINI_API_KEY=replace_me
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_API_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
EMBEDDING_RETRY_MAX_BACKOFF_SECONDS=4
ANSWER_MODEL=gemini-2.5-flash
ANSWER_API_TIMEOUT_SECONDS=30
ANSWER_MAX_RETRIES=2
ANSWER_RETRY_BACKOFF_SECONDS=0.5
ANSWER_RETRY_MAX_BACKOFF_SECONDS=4
